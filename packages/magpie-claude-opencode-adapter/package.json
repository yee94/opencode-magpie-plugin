{
  "name": "magpie-claude-opencode-adapter",
  "version": "0.1.1",
  "type": "module",
  "description": "OpenCode prompt adapter for Magpie's Claude Code subscription channel",
  "files": [
    "adapter.middleware.js",
    "README.md"
  ],
  "magpie": {
    "middleware": "./adapter.middleware.js",
    "options": {
      "agents": [
        "opencode"
      ],
      "placement": "user",
      "renameIdentity": true
    }
  },
  "scripts": {
    "lint": "biome check adapter.middleware.js adapter.test.js package.json",
    "test": "vitest run adapter.test.js",
    "check": "pnpm lint && pnpm test && node --check adapter.middleware.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yee94/opencode-magpie-plugin.git",
    "directory": "packages/magpie-claude-opencode-adapter"
  },
  "homepage": "https://github.com/yee94/opencode-magpie-plugin/tree/main/packages/magpie-claude-opencode-adapter#readme",
  "bugs": {
    "url": "https://github.com/yee94/opencode-magpie-plugin/issues"
  },
  "keywords": [
    "magpie",
    "opencode",
    "middleware",
    "claude"
  ],
  "license": "MIT"
}
