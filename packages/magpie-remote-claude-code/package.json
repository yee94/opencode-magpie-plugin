{
  "name": "magpie-remote-claude-code",
  "version": "0.1.5",
  "description": "Claude Code on another computer's Magpie, shown and managed as a Claude Code provider: the remote's Claude usage, automatic refresh and scheduled warm-up",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "page",
    "README.md",
    "LICENSE"
  ],
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "Remote CC Warm-up",
      "titles": {
        "zh": "Remote CC 预热"
      },
      "file": "page/index.html"
    },
    "actions": [
      {
        "id": "remote-cc-warmup",
        "menu": "provider",
        "title": "Remote CC Warm-up",
        "titles": {
          "zh": "Remote CC 预热设置"
        }
      }
    ],
    "options": {
      "warmAts": [
        "06:00"
      ],
      "warmModel": "",
      "claudeUser": "",
      "refreshEvery": 120
    }
  },
  "scripts": {
    "lint": "biome check index.mjs src page tests package.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm test && node --check index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yee94/opencode-magpie-plugin.git",
    "directory": "packages/magpie-remote-claude-code"
  },
  "homepage": "https://github.com/yee94/opencode-magpie-plugin/tree/main/packages/magpie-remote-claude-code#readme",
  "bugs": {
    "url": "https://github.com/yee94/opencode-magpie-plugin/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "claude-code",
    "remote-magpie"
  ],
  "license": "MIT"
}
